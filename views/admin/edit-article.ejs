<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Article - CXO TechBOT Admin</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f7fa;
      color: #333;
    }
    .header {
      background: white;
      border-bottom: 1px solid #e0e0e0;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .header h1 {
      font-size: 24px;
    }
    .back-link {
      color: #667eea;
      text-decoration: none;
      font-size: 14px;
    }
    .back-link:hover {
      text-decoration: underline;
    }
    .container {
      max-width: 600px;
      margin: 30px auto;
      padding: 0 20px;
    }
    .form-card {
      background: white;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #555;
    }
    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-family: inherit;
      font-size: 14px;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    textarea {
      resize: vertical;
      min-height: 100px;
    }
    .button-group {
      display: flex;
      gap: 10px;
      margin-top: 30px;
    }
    button, .cancel-btn {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.3s;
    }
    button[type="submit"] {
      background: #667eea;
      color: white;
    }
    .cancel-btn {
      background: #e0e0e0;
      color: #333;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    button:hover, .cancel-btn:hover {
      opacity: 0.8;
    }
    .help-text {
      font-size: 12px;
      color: #999;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>✏️ Edit Article</h1>
    <a href="/admin/articles" class="back-link">← Back to Articles</a>
  </div>

  <div class="container">
    <div class="form-card">
      <form method="POST" action="/admin/articles/update/<%= article.id %>">
        <div class="form-group">
          <label for="title">Title *</label>
          <input type="text" id="title" name="title" required value="<%= article.title %>">
        </div>

        <div class="form-group">
          <label for="category">Category *</label>
          <select id="category" name="category" required>
            <option value="">-- Select Category --</option>
            <option value="ai" <%= article.category === 'ai' ? 'selected' : '' %>>AI</option>
            <option value="startup" <%= article.category === 'startup' ? 'selected' : '' %>>Startup</option>
            <option value="product" <%= article.category === 'product' ? 'selected' : '' %>>Product</option>
            <option value="leadership" <%= article.category === 'leadership' ? 'selected' : '' %>>Leadership</option>
            <option value="cloud" <%= article.category === 'cloud' ? 'selected' : '' %>>Cloud</option>
          </select>
        </div>

        <div class="form-group">
          <label for="summary">Summary *</label>
          <textarea id="summary" name="summary" required><%= article.summary %></textarea>
          <div class="help-text">Keep it concise (1-2 sentences)</div>
        </div>

        <div class="form-group">
          <label for="url">Article URL *</label>
          <input type="url" id="url" name="url" required value="<%= article.url %>">
        </div>

        <div class="form-group">
          <label for="tags">Tags (comma-separated)</label>
          <input type="text" id="tags" name="tags" value="<%= article.tags ? article.tags.join(', ') : '' %>">
          <div class="help-text">Separate multiple tags with commas</div>
        </div>

        <div class="button-group">
          <button type="submit">💾 Save Changes</button>
          <a href="/admin/articles" class="cancel-btn">❌ Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
